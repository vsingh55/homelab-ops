# ==========================================================
# PROXMOX API & AUTHENTICATION
# ==========================================================

# The full URL to your Proxmox API. 
# Example: "https://<PROXMOX_IP>:8006/api2/json"
proxmox_api_url = ""

# The API Token ID generated in Proxmox.
# Format: <username>@<realm>!<token_name>
proxmox_api_token_id = ""

# The secret UUID associated with the API Token ID.
proxmox_api_token_secret = ""

# The public SSH key used to inject into VMs for passwordless access.
# Format: "ssh-ed25519 <KEY_STRING> <COMMENT>"
ssh_key = ""

# Password for the Gateway LXC/VM user.
# Ensure this satisfies complexity requirements.
passwordGW = ""

# ==========================================================
# ZONE A: LAB (ACADEMY PLANE)
# ==========================================================

# Gateway Configuration (LXC)
gateway_config = {
  # Static IP address for the Gateway container.
  ip = ""
  
  # Boolean (true/false). Set to true if this should start automatically when Proxmox boots.
  onboot = false 
}

# K8s Lab Cluster Configuration
vms = {
  "jumpbox" = {
    # The unique VM ID in Proxmox (e.g., 200).
    vmid = 0
    
    # Static IP address for the Jumpbox.
    ip = ""
    
    # Number of CPU cores to allocate.
    cores = 0
    
    # RAM allocation in MB.
    memory = 0
    
    # Startup ordering parameters (e.g., "order=4,up=40,down=40").
    startup_param = ""
    
    # Boolean (true/false). Auto-start status.
    onboot = false
  }
  "server" = {
    # The unique VM ID in Proxmox (e.g., 210).
    vmid = 0
    
    # Static IP address for the Control Plane node.
    ip = ""
    
    # Number of CPU cores to allocate.
    cores = 0
    
    # RAM allocation in MB.
    memory = 0
    
    # Startup ordering parameters.
    startup_param = ""
    
    # Boolean (true/false). Auto-start status.
    onboot = false
  }
  "node-0" = {
    # The unique VM ID in Proxmox (e.g., 220).
    vmid = 0
    
    # Static IP address for Worker Node 0.
    ip = ""
    
    # Number of CPU cores to allocate.
    cores = 0
    
    # RAM allocation in MB.
    memory = 0
    
    # Startup ordering parameters.
    startup_param = ""
    
    # Boolean (true/false). Auto-start status.
    onboot = false
  }
  "node-1" = {
    # The unique VM ID in Proxmox (e.g., 221).
    vmid = 0
    
    # Static IP address for Worker Node 1.
    ip = ""
    
    # Number of CPU cores to allocate.
    cores = 0
    
    # RAM allocation in MB.
    memory = 0
    
    # Startup ordering parameters.
    startup_param = ""
    
    # Boolean (true/false). Auto-start status.
    onboot = false
  }
}

# ==========================================================
# ZONE M: MANAGEMENT (OPS-CENTER)
# ==========================================================

ops_center_config = {
  # The unique VM ID in Proxmox (e.g., 900).
  vmid = 0
  
  # Static IP address for the Management VM.
  ip = ""
  
  # Number of CPU cores to allocate.
  cores = 0
  
  # RAM allocation in MB.
  memory = 0
  
  # Disk size string (e.g., "20G").
  disk_size = ""
  
  # Boolean (true/false). Should likely be true for the management plane.
  onboot = false
}

# ==========================================================
# ZONE P: PRODUCTION (APPLICATION PLANE)
# ==========================================================

k3s_prod_config = {
  # The unique VM ID in Proxmox (e.g., 500).
  vmid = 0
  
  # Static IP address for the Production K3s node.
  ip = ""
  
  # Number of CPU cores to allocate.
  cores = 0
  
  # RAM allocation in MB.
  memory = 0
  
  # Disk size string (e.g., "20G").
  disk_size = ""
  
  # Boolean (true/false). Should likely be true for production workloads.
  onboot = false
}